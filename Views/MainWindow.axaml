<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:NetKeyer.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="720"
        x:Class="NetKeyer.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="NetKeyer+Remote - FlexRadio CW Keyer">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <DockPanel>
        <!-- Menu Bar (hidden on macOS, where we use the native menu bar) -->
        <Menu DockPanel.Dock="Top" IsVisible="{Binding IsMenuBarInWindow}">
            <MenuItem Header="_File">
                <MenuItem Header="E_xit" Command="{Binding ExitCommand}"/>
            </MenuItem>
            <MenuItem Header="_Settings">
                <MenuItem Header="_Audio Output Device..." Command="{Binding SelectAudioDeviceCommand}"/>
                <MenuItem Header="_MIDI Note Mapping..." Command="{Binding ConfigureMidiNotesCommand}"/>
                <MenuItem Header="_Access Token..." Command="{Binding ConfigureAccessTokenCommand}"/>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_Documentation" Command="{Binding OpenDocumentationCommand}"/>
                <MenuItem Header="_View Debug Log..." Command="{Binding OpenDebugLogCommand}"/>
                <MenuItem Header="_About NetKeyer+Remote..." Command="{Binding ShowAboutCommand}"/>
            </MenuItem>
        </Menu>

        <!-- Status Bar (Operating Page Only) -->
        <Border DockPanel.Dock="Bottom" 
                BorderBrush="Gray" 
                BorderThickness="0,1,0,0" 
                Background="#2F2F2F"
                Padding="8,4"
                IsVisible="{Binding IsOperatingPage}">
            <Border.Styles>
                <Style Selector="TextBlock">
                    <Setter Property="Foreground" Value="#F2F2F2"/>
                </Style>
            </Border.Styles>
            <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                <!-- Left: Radio Connection Status -->
                <TextBlock Grid.Column="0" 
                           Text="{Binding ConnectedRadioDisplay}"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Margin="0,0,10,0"/>

                <!-- CW Settings (Mode and Speed) -->
                <StackPanel Grid.Column="1" 
                            Orientation="Horizontal" 
                            VerticalAlignment="Center"
                            Spacing="15">
                    <TextBlock Text="{Binding ModeDisplay}"
                               FontSize="12"
                               VerticalAlignment="Center"/>
                    <TextBlock VerticalAlignment="Center"
                               FontSize="12"
                               IsVisible="{Binding CwSettingsVisible}">
                        <Run Text="Speed:"/>
                        <Run Text="{Binding CwSpeed}"/>
                        <Run Text="WPM"/>
                    </TextBlock>
                </StackPanel>

                <!-- Middle: Network Connection Status (single-line to preserve bar height) -->
                <TextBlock Grid.Column="2"
                           FontSize="12"
                           VerticalAlignment="Center"
                           Margin="12,0,12,0"
                           Text="{Binding RemoteStatusBarText}"
                           TextTrimming="CharacterEllipsis"/>

                <!-- Right: Paddle Status LEDs -->
                <StackPanel Grid.Column="3" 
                            Orientation="Horizontal" 
                            Spacing="8"
                            VerticalAlignment="Center">
                    <Ellipse Width="16" 
                             Height="16"
                             Fill="{Binding LeftPaddleIndicatorColor}"
                             Stroke="DarkGray"
                             StrokeThickness="1"
                             ToolTip.Tip="{Binding LeftPaddleLabelText}"/>
                    <Ellipse Width="16" 
                             Height="16"
                             Fill="{Binding RightPaddleIndicatorColor}"
                             Stroke="DarkGray"
                             StrokeThickness="1"
                             IsVisible="{Binding RightPaddleVisible}"
                             ToolTip.Tip="Right Paddle"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <ScrollViewer>
            <StackPanel Margin="10" Spacing="8">

                <!-- Setup Page -->
                <StackPanel Spacing="8" IsVisible="{Binding IsSetupPage}">

                    <!-- SmartLink Section -->
                    <Border BorderBrush="Gray" BorderThickness="1" Padding="8" CornerRadius="3"
                            IsVisible="{Binding SmartLinkAvailable}">
                        <StackPanel Spacing="6">
                            <TextBlock Text="SmartLink" FontWeight="Bold" FontSize="14"/>

                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button Content="{Binding SmartLinkButtonText}"
                                        Command="{Binding ToggleSmartLinkCommand}"
                                        Width="180"
                                        HorizontalContentAlignment="Center"
                                        Padding="4"/>
                                <TextBlock Text="{Binding SmartLinkStatus}"
                                           VerticalAlignment="Center"
                                           FontSize="12"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Connection Mode -->
                    <Border BorderBrush="Gray" BorderThickness="1" Padding="8" CornerRadius="3">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Connection Mode" FontWeight="Bold" FontSize="14"/>

                            <StackPanel Orientation="Horizontal" Spacing="15">
                                <RadioButton Content="Standalone"
                                             GroupName="RemoteMode"
                                             IsChecked="{Binding IsRemoteModeOff}"
                                             Padding="2"/>
                                <RadioButton Content="Client"
                                             GroupName="RemoteMode"
                                             IsChecked="{Binding IsRemoteModeClient}"
                                             Padding="2"/>
                                <RadioButton Content="Host"
                                             GroupName="RemoteMode"
                                             IsChecked="{Binding IsRemoteModeHost}"
                                             Padding="2"/>
                            </StackPanel>

                            <TextBlock Text="{Binding RemoteStatus}" FontSize="12" Foreground="DimGray"/>
                        </StackPanel>
                    </Border>

                    <!-- Network Connection -->
                    <Border BorderBrush="Gray" BorderThickness="1" Padding="8" CornerRadius="3"
                            IsVisible="{Binding !IsRemoteModeOff}">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Network Connection" FontWeight="Bold" FontSize="14"/>

                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="Callsign:" Width="110" VerticalAlignment="Center"/>
                                <TextBox Text="{Binding RemoteCallsign}" Width="220"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <CheckBox Content="Use Rendezvous"
                                          IsChecked="{Binding RemoteUseRendezvous}"
                                          VerticalAlignment="Center"/>
                                <Button Content="Test Rendezvous Auth"
                                        Command="{Binding TestRendezvousConnectionCommand}"
                                        Foreground="{Binding RendezvousAuthTestButtonBrush}"
                                        Width="170"
                                        HorizontalContentAlignment="Center"
                                        Padding="4"
                                        IsVisible="{Binding RemoteUseRendezvous}"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding RemoteUseRendezvous}">
                                <TextBlock Text="ID Server:" Width="110" VerticalAlignment="Center"/>
                                <TextBox Text="{Binding RemoteRendezvousServer}" Width="240"/>
                                <TextBlock Text="Port:" Width="36" VerticalAlignment="Center"/>
                                <NumericUpDown Value="{Binding RemoteRendezvousPort}" Minimum="1" Maximum="65535" Width="80" ShowButtonSpinner="False"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding RemoteUseRendezvous}">
                                <TextBlock Text="Host ID:" Width="110" VerticalAlignment="Center"/>
                                <TextBox Text="{Binding RemoteRendezvousHostId}" Width="320"/>
                            </StackPanel>

                            <StackPanel Spacing="6" IsVisible="{Binding IsRemoteModeClient}">
                                <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding RemoteUseRendezvous}">
                                    <TextBlock Text="Select Host:" Width="110" VerticalAlignment="Center"/>
                                    <ComboBox ItemsSource="{Binding RendezvousDiscoveredHosts}"
                                              SelectedItem="{Binding SelectedRendezvousHost}"
                                              Width="320"
                                              PlaceholderText="Refresh to discover hosts..."/>
                                    <Button Content="Refresh"
                                            Command="{Binding RefreshRendezvousHostsCommand}"
                                            Width="70"
                                            HorizontalContentAlignment="Center"
                                            Padding="4"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="Host IP:" Width="110" VerticalAlignment="Center"/>
                                    <TextBox Text="{Binding RemoteClientHost}" Width="220"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="Host Port:" Width="110" VerticalAlignment="Center"/>
                                    <NumericUpDown Value="{Binding RemoteClientPort}" Minimum="1" Maximum="65535" Width="140" ShowButtonSpinner="False"/>
                                </StackPanel>

                                <TextBlock FontSize="12" Foreground="DimGray">
                                    <Run Text="Connected host: "/>
                                    <Run Text="{Binding RemoteConnectedHostIp}"/>
                                    <Run Text=" "/>
                                    <Run Text="{Binding RemoteConnectedHostName}"/>
                                </TextBlock>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="Shared Token:" Width="110" VerticalAlignment="Center"/>
                                <TextBox Text="{Binding RemoteSharedToken}" Width="220"/>
                            </StackPanel>

                        </StackPanel>
                    </Border>

                    <!-- Host Settings -->
                    <Border BorderBrush="Gray" BorderThickness="1" Padding="8" CornerRadius="3"
                            IsVisible="{Binding IsRemoteModeHost}">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Host Settings" FontWeight="Bold" FontSize="14"/>

                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="Host Name:" Width="110" VerticalAlignment="Center"/>
                                <TextBox Text="{Binding RemoteHostName}" Width="220"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="Bind Address:" Width="110" VerticalAlignment="Center"/>
                                <TextBox Text="{Binding RemoteHostBindAddress}" Width="220"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="Listen Port:" Width="110" VerticalAlignment="Center"/>
                                <NumericUpDown Value="{Binding RemoteHostPort}" Minimum="1" Maximum="65535" Width="140" ShowButtonSpinner="False"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="Max Clients:" Width="110" VerticalAlignment="Center"/>
                                <NumericUpDown Value="{Binding RemoteMaxClients}"
                                               Minimum="1"
                                               Maximum="5"
                                               Increment="1"
                                               FormatString="F0"
                                               Width="110"/>
                                <TextBlock Text="Hold Time:" Width="84" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                <NumericUpDown Value="{Binding RemoteClientHoldSeconds}"
                                               Minimum="0.5"
                                               Maximum="30.0"
                                               Increment="0.5"
                                               FormatString="F1"
                                               Width="110"/>
                                <TextBlock Text="sec" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Radio Selection -->
                    <Border BorderBrush="Gray" BorderThickness="1" Padding="8" CornerRadius="3"
                            IsVisible="{Binding !IsRemoteModeClient}">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Radio Selection" FontWeight="Bold" FontSize="14"/>

                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ComboBox Name="RadioComboBox"
                                          ItemsSource="{Binding RadioClientSelections}"
                                          SelectedItem="{Binding SelectedRadioClient}"
                                          Width="450"
                                          PlaceholderText="Select a radio and station..."/>
                                <Button Content="Refresh"
                                        Command="{Binding RefreshRadiosCommand}"
                                        Width="70"
                                        HorizontalContentAlignment="Center"
                                        Padding="4"/>
                            </StackPanel>

                            <!-- Status - only shown on error -->
                            <TextBlock Text="{Binding RadioStatus}"
                                       Foreground="{Binding RadioStatusColor}"
                                       IsVisible="{Binding HasRadioError}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Input Device Selection -->
                    <Border BorderBrush="Gray" BorderThickness="1" Padding="8" CornerRadius="3">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Input Device Selection" FontWeight="Bold" FontSize="14"/>

                            <!-- Input Type Selector -->
                            <StackPanel Spacing="3">
                                <TextBlock Text="Input Type:" FontSize="12"/>
                                <StackPanel Orientation="Horizontal" Spacing="15">
                                    <RadioButton Content="Serial Port (HaliKey v1)"
                                                 GroupName="InputType"
                                                 IsChecked="{Binding IsSerialInput}"
                                                 Padding="2"/>
                                    <RadioButton Content="MIDI (HaliKey MIDI, CTR2)"
                                                 GroupName="InputType"
                                                 IsChecked="{Binding IsMidiInput}"
                                                 Padding="2"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Serial Port Settings -->
                            <StackPanel Spacing="6" IsVisible="{Binding IsSerialInput}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="Port:" VerticalAlignment="Center" Width="110"/>
                                    <ComboBox ItemsSource="{Binding SerialPorts}"
                                              SelectedItem="{Binding SelectedSerialPort}"
                                              Width="280"
                                              PlaceholderText="Select a port..."/>
                                    <Button Content="Refresh"
                                            Command="{Binding RefreshSerialPortsCommand}"
                                            Width="70"
                                            HorizontalContentAlignment="Center"
                                            Padding="4"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- MIDI Device Settings -->
                            <StackPanel Spacing="6" IsVisible="{Binding IsMidiInput}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="MIDI Device:" VerticalAlignment="Center" Width="100"/>
                                    <ComboBox ItemsSource="{Binding MidiDevices}"
                                              SelectedItem="{Binding SelectedMidiDevice}"
                                              Width="280"
                                              PlaceholderText="Select a MIDI device..."/>
                                    <Button Content="Refresh"
                                            Command="{Binding RefreshMidiDevicesCommand}"
                                            Width="70"
                                            HorizontalContentAlignment="Center"
                                            Padding="4"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Connect Buttons -->
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Spacing="10"
                                Margin="0,5,0,0">
                        <Button Content="Connect"
                                Command="{Binding ToggleConnectionCommand}"
                                HorizontalContentAlignment="Center"
                                Width="120"
                                Padding="6"/>
                        <Button Content="Connect by IP..."
                                Command="{Binding ConnectByIpCommand}"
                                HorizontalContentAlignment="Center"
                                Width="120"
                                Padding="6"/>
                        <Button Content="Exit"
                            Command="{Binding ExitCommand}"
                            HorizontalContentAlignment="Center"
                            Width="100"
                            Padding="6"/>
                    </StackPanel>
                </StackPanel>

                <!-- Operating Page -->
                <StackPanel Spacing="8" IsVisible="{Binding IsOperatingPage}">

                    <!-- CW Settings Section -->
                    <Border BorderBrush="Gray" BorderThickness="1" Padding="8" CornerRadius="3"
                            IsVisible="{Binding CwSettingsVisible}">
                        <StackPanel Spacing="3">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0"
                                           Text="CW Settings"
                                           FontWeight="Bold"
                                           FontSize="14"
                                           VerticalAlignment="Center"/>
                                <Button Grid.Column="1"
                                        Content="Disconnect"
                                        Command="{Binding ToggleConnectionCommand}"
                                        HorizontalContentAlignment="Center"
                                        VerticalAlignment="Center"
                                        Height="24"
                                        FontSize="13"
                                        Padding="8,0"
                                    IsVisible="{Binding IsRemoteModeOff}"/>
                            </Grid>

                            <!-- Speed -->
                            <StackPanel Orientation="Horizontal" Spacing="6" MinHeight="26">
                                <TextBlock Text="Speed (WPM):" Width="100" VerticalAlignment="Center" FontSize="11"/>
                                <NumericUpDown Value="{Binding CwSpeed}"
                                               Minimum="5"
                                               Maximum="60"
                                               Increment="1"
                                               FormatString="F0"
                                               Width="108"
                                               Height="24"
                                               FontSize="11"
                                               ShowButtonSpinner="True"/>
                                <TextBlock Text="Keyer Mode:" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                <RadioButton Content="Iambic"
                                             GroupName="KeyerMode"
                                             IsChecked="{Binding IsIambicMode}"
                                             FontSize="10"
                                             MinHeight="22"
                                             VerticalAlignment="Center"
                                             Padding="2,1"/>
                                <RadioButton Content="Straight Key"
                                             GroupName="KeyerMode"
                                             IsChecked="{Binding !IsIambicMode}"
                                             FontSize="10"
                                             MinHeight="22"
                                             VerticalAlignment="Center"
                                             Padding="2,1"/>
                            </StackPanel>

                            <!-- Sidetone Volume -->
                            <StackPanel Orientation="Horizontal" Spacing="6" MinHeight="26">
                                <TextBlock Text="Sidetone:" Width="100" VerticalAlignment="Center" FontSize="11"/>
                                <NumericUpDown Value="{Binding SidetoneVolume}"
                                               Minimum="0"
                                               Maximum="100"
                                               Increment="1"
                                               FormatString="F0"
                                               Width="108"
                                               Height="24"
                                               FontSize="11"
                                               ShowButtonSpinner="True"/>
                                <TextBlock Text="Iambic Type:" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                <RadioButton Content="Mode A"
                                             GroupName="IambicType"
                                             IsChecked="{Binding !IsIambicModeB}"
                                             IsEnabled="{Binding IsIambicMode}"
                                             FontSize="10"
                                             MinHeight="22"
                                             VerticalAlignment="Center"
                                             Padding="2,1"/>
                                <RadioButton Content="Mode B"
                                             GroupName="IambicType"
                                             IsChecked="{Binding IsIambicModeB}"
                                             IsEnabled="{Binding IsIambicMode}"
                                             FontSize="10"
                                             MinHeight="22"
                                             VerticalAlignment="Center"
                                             Padding="2,1"/>
                            </StackPanel>

                            <!-- Pitch -->
                            <StackPanel Orientation="Horizontal" Spacing="6" MinHeight="26">
                                <TextBlock Text="Pitch (Hz):" Width="100" VerticalAlignment="Center" FontSize="11"/>
                                <NumericUpDown Value="{Binding CwPitch}"
                                               Minimum="300"
                                               Maximum="1000"
                                               Increment="10"
                                               FormatString="F0"
                                               Width="108"
                                               Height="24"
                                               FontSize="11"
                                               ShowButtonSpinner="True"/>
                                <CheckBox Content="Swap Paddles"
                                          IsChecked="{Binding SwapPaddles}"
                                          IsEnabled="{Binding IsIambicMode}"
                                          FontSize="10"
                                          MinHeight="22"
                                          VerticalAlignment="Center"
                                          Margin="8,0,0,0"
                                          Padding="1"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Host Client Status Section -->
                    <Border BorderBrush="Gray" BorderThickness="1" Padding="8" CornerRadius="3"
                            IsVisible="{Binding IsRemoteModeHost}">
                        <StackPanel Spacing="6">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <TextBlock Text="Host Status"
                                               FontWeight="Bold"
                                               FontSize="14"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding RemoteHostTitleStatusText}"
                                               FontSize="12"
                                               Foreground="DimGray"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Content="Disconnect"
                                        Command="{Binding ToggleConnectionCommand}"
                                        HorizontalContentAlignment="Center"
                                        VerticalAlignment="Center"
                                        Height="24"
                                        FontSize="13"
                                        Padding="8,0"/>
                            </Grid>

                                <StackPanel Orientation="Horizontal"
                                    Spacing="6"
                                    IsVisible="{Binding IsRemoteModeHost}">
                                <TextBlock Text="{Binding RemoteHostConnectionStateText}"
                                       FontSize="13"
                                       Foreground="DimGray"/>
                                <TextBlock Text="|"
                                       FontSize="13"
                                       Foreground="DimGray"/>
                                <TextBlock Text="{Binding RemoteHostRendezvousStatusText}"
                                       FontSize="13"
                                       Foreground="{Binding RemoteHostRendezvousStatusBrush}"/>
                                </StackPanel>

                            <Grid ColumnDefinitions="118,96,70,*" ColumnSpacing="6">
                                <TextBlock Grid.Column="0" Text="IP Address" FontWeight="SemiBold" FontSize="13"/>
                                <TextBlock Grid.Column="1" Text="Callsign" FontWeight="SemiBold" FontSize="13"/>
                                <TextBlock Grid.Column="2" Text="Status" FontWeight="SemiBold" FontSize="13"/>
                                <TextBlock Grid.Column="3" Text="Last Active" FontWeight="SemiBold" FontSize="13"/>
                            </Grid>

                            <ItemsControl ItemsSource="{Binding RemoteHostClientDisplayRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="118,96,70,*" ColumnSpacing="6" Height="24">
                                            <TextBlock Grid.Column="0" Text="{Binding RemoteIp}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Callsign}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Status}" FontSize="13" Foreground="{Binding StatusBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="3" Text="{Binding LastActive}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" Margin="0,2,0,0">
                                <TextBlock Grid.Row="0"
                                           Grid.Column="0"
                                           Text="{Binding RemoteTelemetryLabel}"
                                           FontSize="12"
                                           Foreground="#FF00FF"
                                           FontWeight="Bold"
                                           Margin="0,0,4,0"/>
                                <TextBlock Grid.Row="0"
                                           Grid.Column="1"
                                           Text="{Binding RemoteTelemetryLine1}"
                                           FontSize="12"
                                           Foreground="#FF00FF"
                                           FontWeight="Bold"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Row="1"
                                           Grid.Column="1"
                                           Text="{Binding RemoteTelemetryLine2}"
                                           FontSize="12"
                                           Foreground="#FF00FF"
                                           FontWeight="Bold"
                                           TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Client Host Status Section -->
                    <Border BorderBrush="Gray" BorderThickness="1" Padding="8" CornerRadius="3"
                            IsVisible="{Binding IsRemoteModeClient}">
                        <StackPanel Spacing="6">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <TextBlock Grid.Column="0"
                                           Text="Client Status"
                                           FontWeight="Bold"
                                           FontSize="14"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1"
                                           Margin="8,0,0,0"
                                           Text="{Binding RemoteClientTitleStatusText}"
                                           FontSize="12"
                                           Foreground="DimGray"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                                <Button Grid.Column="2"
                                        Content="Disconnect"
                                        Command="{Binding ToggleConnectionCommand}"
                                        HorizontalContentAlignment="Center"
                                        VerticalAlignment="Center"
                                        Height="24"
                                        FontSize="13"
                                        Padding="8,0"/>
                            </Grid>

                            <Grid ColumnDefinitions="2*,2*,*">
                                <TextBlock Grid.Column="0" Text="Host IP" FontWeight="SemiBold" FontSize="13"/>
                                <TextBlock Grid.Column="1" Text="Host Name" FontWeight="SemiBold" FontSize="13"/>
                                <TextBlock Grid.Column="2" Text="Status" FontWeight="SemiBold" FontSize="13"/>
                            </Grid>

                            <Grid ColumnDefinitions="2*,2*,*" Height="24">
                                <TextBlock Grid.Column="0"
                                           Text="{Binding RemoteConnectedHostIpDisplay}"
                                           FontSize="13"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding RemoteConnectedHostName}"
                                           FontSize="13"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2"
                                           Text="{Binding RemoteClientConnectionStatusText}"
                                           FontSize="13"
                                           Foreground="{Binding RemoteClientConnectionStatusBrush}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                            </Grid>

                            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" Margin="0,2,0,0">
                                <TextBlock Grid.Row="0"
                                           Grid.Column="0"
                                           Text="{Binding RemoteTelemetryLabel}"
                                           FontSize="12"
                                           Foreground="#FF00FF"
                                           FontWeight="Bold"
                                           Margin="0,0,4,0"/>
                                <TextBlock Grid.Row="0"
                                           Grid.Column="1"
                                           Text="{Binding RemoteTelemetryLine1}"
                                           FontSize="12"
                                           Foreground="#FF00FF"
                                           FontWeight="Bold"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Row="1"
                                           Grid.Column="1"
                                           Text="{Binding RemoteTelemetryLine2}"
                                           FontSize="12"
                                           Foreground="#FF00FF"
                                           FontWeight="Bold"
                                           TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>

</Window>
